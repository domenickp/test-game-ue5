# Unreal Engine generated directories
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Generated project files
*.sln
*.suo
*.sdf
*.opensdf
*.opendb
*.VC.db
*.VC.opendb
*.xcodeproj
*.xcworkspace

# IDE
.vs/
.idea/

# OS
Thumbs.db
.DS_Store

# Machine-local agent settings
.claude/settings.local.json

# Beads local state
.beads/*.db
.beads/*.db-shm
.beads/*.db-wal

# Machine-local secret generated by 'bd init'; bd's own .beads/.gitignore misses it
.beads/.beads-credential-key
.beads/dolt-server.log
.beads/dolt-server.lock
.beads/interactions.jsonl
.beads/.local_version
.beads/backup/

# Dolt database files (added by bd init)
.dolt/
*.db
